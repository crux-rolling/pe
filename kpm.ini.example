# /etc/kpm.ini - kpm package manager configuration for CRUX Linux
#
# Edit manually to customize build flags, paths, and binary repository settings.
# Override the config path with: kpm --config /path/to/kpm.ini <command>
# or environment variable: KPM_CONFIG=/path/to/kpm.ini

[paths]
# Installation root (standard CRUX root is /)
root = /

# CRUX ports tree location(s) (comma- or colon-separated priority order)
ports_dir = /usr/ports

# Comma- or space-separated port collections in priority order
# Leave empty to auto-discover all collections under ports_dir
collections = pkg-tools, kernel, core, opt, xorg, contrib, compat-32

# Directory for cached binary packages and synced index.json
cache_dir = /var/cache/kpm

# Directory for cached downloaded source tarballs used by `kpm build`
source_cache = /var/cache/kpm/sources

# Directory where `kpm build` places compiled .pkg.tar.<ext> archives
package_dir = /var/cache/kpm/packages

# Working directory for `kpm build` ($SRC and $PKG)
work_dir = /var/cache/kpm/work

# CRUX pkgadd configuration file (INSTALL/UPGRADE rules)
pkgadd_conf = /etc/pkgadd.conf

# Trusted Ed25519 release signing public keys (*.pub, kryx-ed25519 or ssh-ed25519)
keys_dir = /etc/kpm/keys.d

# CRUX ports sync config/drivers directories
ports_conf_dir = /etc/ports
ports_drivers_dir = /etc/ports/drivers

[repo]
# Primary binary repository release index (kryx-linux/ports rolling-x86_64)
repository = kryx-linux/ports
tag = rolling-x86_64
arch = x86_64
index_url = https://github.com/kryx-linux/ports/releases/download/rolling-x86_64/index.json
verify_index_signature = false
# Optional explicit signify/Ed25519 public key file (in addition to keys_dir/*.pub)
# pubkey = /etc/kpm/keys.d/kryx-release.pub

# Optional comma- or space-separated packages held/pinned during `kpm update`
# hold = linux, glibc

# HTTP timeout in seconds for syncing index.json and downloading binaries
timeout_seconds = 120

# Optional multi-repo configuration (priority order: first defined wins):
# [repo.rolling]
# repository = kryx-linux/ports
# tag = rolling-x86_64
# arch = x86_64
# verify_signature = true
#
# [repo.testing]
# repository = kryx-linux/ports
# tag = testing-x86_64
# arch = x86_64

[build]
# Parallel build jobs (exported as JOBS and used in MAKEFLAGS if makeflags is unset)
jobs = 4

# Compiler/linker flags exported to Pkgfile build()
cflags = -O2 -march=x86-64 -pipe
cxxflags = -O2 -march=x86-64 -pipe
ldflags =
makeflags = -j4

# Package archive compression: zst, xz, gz, bz2, lz
compression = zst

# Optional space-separated source mirror base URLs
source_mirrors =

# pkgmk-compatible build behavior flags (true/false)
download_sources = true
strip = true
compress_manpages = true
ignore_footprint = false
ignore_new = false
ignore_md5sum = false
ignore_signature = true
keep_work = false

# Source downloader program (curl or wget)
download_prog = curl
curl_opts =
wget_opts =

[ui]
# Color output mode: auto (TTY-aware, respects NO_COLOR), always, or never
color = auto
