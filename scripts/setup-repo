#!/usr/bin/env bash
# setup-repo - Initialize KryX Linux pe/gports repositories and keyring on host or target root.
# Works from any live Linux ISO (CRUX, Arch, Debian, Fedora, Alpine) with static `pe`.
set -euo pipefail

TARGET_ROOT="/"
REPO_SLUG="kryx-linux/ports"
RELEASE_TAG="rolling-x86_64"
ARCH="x86_64"
INDEX_URL=""
PORTS_DIR="/usr/ports"
KEY_SRC=""
VERIFY_SIG="false"
DO_SYNC=1
DO_SYNC_PORTS=0
PE_BIN="$(command -v pe 2>/dev/null || echo /usr/bin/pe)"

usage() {
    cat <<'EOF'
Usage: setup-repo [options]

Initialize /etc/pe.ini, /etc/gports/sources.list, /etc/pe/keys.d, and /var/lib/pkg/db
for KryX Linux (either on the running system or inside a target --root /mnt).

Options:
  --root <dir>        Target rootfs directory (default: /)
  --repo <owner/repo> Binary GitHub repository slug (default: kryx-linux/ports)
  --tag <tag>         Binary release tag (default: rolling-x86_64)
  --arch <arch>       Target architecture (default: x86_64)
  --index-url <url>   Explicit index.json URL (overrides --repo/--tag)
  --ports-dir <dir>   Local ports directory inside root (default: /usr/ports)
  --key <file|url>    Trust an Ed25519 release signing public key in keys.d
  --verify            Enable verify_signature = true in pe.ini
  --sync-ports        Also sync /usr/ports using gports if installed
  --no-sync           Write configs without contacting the network
  --pe-bin <path>     Path to pe binary (default: auto-detected)
  -h, --help          Show this help message
EOF
}

while [[ $# -gt 0 ]]; do
    case "$1" in
        --root)       TARGET_ROOT="$2"; shift 2 ;;
        --repo)       REPO_SLUG="$2"; shift 2 ;;
        --tag)        RELEASE_TAG="$2"; shift 2 ;;
        --arch)       ARCH="$2"; shift 2 ;;
        --index-url)  INDEX_URL="$2"; shift 2 ;;
        --ports-dir)  PORTS_DIR="$2"; shift 2 ;;
        --key)        KEY_SRC="$2"; shift 2 ;;
        --verify)     VERIFY_SIG="true"; shift ;;
        --sync-ports) DO_SYNC_PORTS=1; shift ;;
        --no-sync)    DO_SYNC=0; shift ;;
        --pe-bin)     PE_BIN="$2"; shift 2 ;;
        -h|--help)    usage; exit 0 ;;
        *)            echo "setup-repo: unknown option: $1" >&2; usage >&2; exit 2 ;;
    esac
done

ROOT_PREFIX="${TARGET_ROOT%/}"
if [[ -z "$INDEX_URL" ]]; then
    INDEX_URL="https://github.com/${REPO_SLUG}/releases/download/${RELEASE_TAG}/index.json"
fi

echo "[setup-repo] Initializing KryX repository layout under ${TARGET_ROOT}..."
mkdir -p \
    "${ROOT_PREFIX}/etc/pe/keys.d" \
    "${ROOT_PREFIX}/etc/gports/sources.list.d" \
    "${ROOT_PREFIX}/var/lib/pkg" \
    "${ROOT_PREFIX}/var/cache/pe/bin" \
    "${ROOT_PREFIX}/var/cache/pe/sources" \
    "${ROOT_PREFIX}/var/cache/pe/packages" \
    "${ROOT_PREFIX}/var/cache/pe/work" \
    "${ROOT_PREFIX}${PORTS_DIR}"

if [[ ! -f "${ROOT_PREFIX}/var/lib/pkg/db" ]]; then
    : > "${ROOT_PREFIX}/var/lib/pkg/db"
    chmod 0444 "${ROOT_PREFIX}/var/lib/pkg/db"
fi

PE_INI="${ROOT_PREFIX}/etc/pe.ini"
cat > "$PE_INI" <<EOF
# /etc/pe.ini - KryX Linux package manager configuration (generated by setup-repo)

[paths]
root = /
ports_dir = ${PORTS_DIR}
collections = rolling, core, opt, xorg, contrib
cache_dir = /var/cache/pe
source_cache = /var/cache/pe/sources
package_dir = /var/cache/pe/packages
work_dir = /var/cache/pe/work
pkgadd_conf = /etc/pkgadd.conf
keys_dir = /etc/pe/keys.d
ports_conf_dir = /etc/ports
ports_drivers_dir = /etc/ports/drivers

[repo]
repository = ${REPO_SLUG}
tag = ${RELEASE_TAG}
arch = ${ARCH}
index_url = ${INDEX_URL}
verify_signature = ${VERIFY_SIG}
timeout_seconds = 120

[build]
jobs = $(nproc 2>/dev/null || echo 4)
cflags = -O2 -march=x86-64 -pipe
cxxflags = -O2 -march=x86-64 -pipe
ldflags =
compression = zst
download_sources = true
strip = true
compress_manpages = true
ignore_footprint = false
ignore_new = false
ignore_md5sum = false
ignore_signature = true
keep_work = false
download_prog = curl

[ui]
color = auto
EOF
chmod 0644 "$PE_INI"

GPORTS_LIST="${ROOT_PREFIX}/etc/gports/sources.list"
if [[ ! -f "$GPORTS_LIST" ]]; then
    cat > "$GPORTS_LIST" <<EOF
# /etc/gports/sources.list - KryX Linux ports collections (overlay: rolling -> CRUX)
# Format: <protocol> <collection> <url> [destination]
# Place custom third-party overlays in /etc/gports/sources.list.d/*.list
git rolling https://github.com/${REPO_SLUG}.git ${PORTS_DIR}/rolling-repo
git core    https://git.crux.nu/ports/core.git
git opt     https://git.crux.nu/ports/opt.git
git xorg    https://git.crux.nu/ports/xorg.git
git contrib https://git.crux.nu/ports/contrib.git
EOF
    chmod 0644 "$GPORTS_LIST"
fi

if [[ ! -f "${ROOT_PREFIX}/etc/pkgadd.conf" ]]; then
    cat > "${ROOT_PREFIX}/etc/pkgadd.conf" <<'EOF'
# /etc/pkgadd.conf - CRUX/KryX package file preservation rules
UPGRADE		^etc/.*$		NO
UPGRADE		^var/log/.*$		NO
UPGRADE		^etc/pe\.ini$		NO
UPGRADE		^etc/gports/sources\.list$	NO
EOF
    chmod 0644 "${ROOT_PREFIX}/etc/pkgadd.conf"
fi

# Create a host-side temporary config pointing cache_dir & keys_dir into TARGET_ROOT
# when bootstrapping an alternative root (so syncing writes into /mnt/var/cache/pe).
HOST_PE_INI="$PE_INI"
TMP_INI=""
cleanup() {
    [[ -n "$TMP_INI" && -f "$TMP_INI" ]] && rm -f "$TMP_INI"
}
trap cleanup EXIT

if [[ "$TARGET_ROOT" != "/" ]]; then
    TMP_INI="$(mktemp "${TMPDIR:-/tmp}/setup-repo-pe.XXXXXX.ini")"
    sed \
        -e "s|^root = .*|root = ${TARGET_ROOT}|" \
        -e "s|^ports_dir = .*|ports_dir = ${ROOT_PREFIX}${PORTS_DIR}|" \
        -e "s|^cache_dir = .*|cache_dir = ${ROOT_PREFIX}/var/cache/pe|" \
        -e "s|^source_cache = .*|source_cache = ${ROOT_PREFIX}/var/cache/pe/sources|" \
        -e "s|^package_dir = .*|package_dir = ${ROOT_PREFIX}/var/cache/pe/packages|" \
        -e "s|^work_dir = .*|work_dir = ${ROOT_PREFIX}/var/cache/pe/work|" \
        -e "s|^keys_dir = .*|keys_dir = ${ROOT_PREFIX}/etc/pe/keys.d|" \
        "$PE_INI" > "$TMP_INI"
    HOST_PE_INI="$TMP_INI"
fi

if [[ -n "$KEY_SRC" ]]; then
    if [[ ! -x "$PE_BIN" ]]; then
        echo "setup-repo: error: pe binary not found at ${PE_BIN} (needed for --key)" >&2
        exit 1
    fi
    "$PE_BIN" --config "$HOST_PE_INI" key trust "$KEY_SRC"
fi

if [[ "$DO_SYNC" -eq 1 ]]; then
    if [[ ! -x "$PE_BIN" ]]; then
        echo "setup-repo: warning: pe binary not found at ${PE_BIN}; skipping index sync" >&2
    else
        echo "[setup-repo] Syncing binary index from ${INDEX_URL}..."
        "$PE_BIN" --config "$HOST_PE_INI" sync
    fi
fi

if [[ "$DO_SYNC_PORTS" -eq 1 ]]; then
    if command -v gports >/dev/null 2>&1; then
        echo "[setup-repo] Syncing local ports tree via gports..."
        gports -c "$GPORTS_LIST" -p "${ROOT_PREFIX}${PORTS_DIR}" -u
    else
        echo "setup-repo: warning: gports not found in PATH; skipping ports sync" >&2
    fi
fi

echo "[setup-repo] Done. Config written to ${PE_INI}."
