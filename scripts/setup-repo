#!/usr/bin/env bash
# setup-repo - Initialize KryX Linux kpm/ports repositories and keyring on host or target root.
# Works from any live Linux ISO (CRUX, Arch, Debian, Fedora, Alpine) with static `kpm`.
set -euo pipefail

TARGET_ROOT="/"
REPO_SLUG="kryx-linux/ports"
RELEASE_TAG="rolling-x86_64"
ARCH="x86_64"
INDEX_URL=""
PORTS_DIR="/usr/ports"
KEY_SRC=""
VERIFY_SIG="false"
DO_SYNC=1
DO_SYNC_PORTS=0
KPM_BIN="$(command -v kpm 2>/dev/null || echo /usr/bin/kpm)"

usage() {
    cat <<'EOF'
Usage: setup-repo [options]

Initialize /etc/kpm.ini, /etc/ports/sources.list, /etc/kpm/keys.d, and /var/lib/pkg/db
for KryX Linux (either on the running system or inside a target --root /mnt).

Options:
  --root <dir>        Target rootfs directory (default: /)
  --repo <owner/repo> Binary GitHub repository slug (default: kryx-linux/ports)
  --tag <tag>         Binary release tag (default: rolling-x86_64)
  --arch <arch>       Target architecture (default: x86_64)
  --index-url <url>   Explicit index.json URL (overrides --repo/--tag)
  --ports-dir <dir>   Local ports directory inside root (default: /usr/ports)
  --key <file|url>    Trust an Ed25519 release signing public key in keys.d
  --verify            Enable verify_signature = true in kpm.ini
  --sync-ports        Also sync /usr/ports using ports (kpm ports) if installed
  --no-sync           Write configs without contacting the network
  --kpm-bin <path>     Path to kpm binary (default: auto-detected)
  -h, --help          Show this help message
EOF
}

while [[ $# -gt 0 ]]; do
    case "$1" in
        --root)       TARGET_ROOT="$2"; shift 2 ;;
        --repo)       REPO_SLUG="$2"; shift 2 ;;
        --tag)        RELEASE_TAG="$2"; shift 2 ;;
        --arch)       ARCH="$2"; shift 2 ;;
        --index-url)  INDEX_URL="$2"; shift 2 ;;
        --ports-dir)  PORTS_DIR="$2"; shift 2 ;;
        --key)        KEY_SRC="$2"; shift 2 ;;
        --verify)     VERIFY_SIG="true"; shift ;;
        --sync-ports) DO_SYNC_PORTS=1; shift ;;
        --no-sync)    DO_SYNC=0; shift ;;
        --kpm-bin)     KPM_BIN="$2"; shift 2 ;;
        -h|--help)    usage; exit 0 ;;
        *)            echo "setup-repo: unknown option: $1" >&2; usage >&2; exit 2 ;;
    esac
done

ROOT_PREFIX="${TARGET_ROOT%/}"
if [[ -z "$INDEX_URL" ]]; then
    INDEX_URL="https://github.com/${REPO_SLUG}/releases/download/${RELEASE_TAG}/index.json"
fi

echo "[setup-repo] Initializing KryX repository layout under ${TARGET_ROOT}..."
mkdir -p \
    "${ROOT_PREFIX}/etc/kpm/keys.d" \
    "${ROOT_PREFIX}/etc/ports/sources.list.d" \
    "${ROOT_PREFIX}/var/lib/pkg" \
    "${ROOT_PREFIX}/var/cache/kpm/bin" \
    "${ROOT_PREFIX}/var/cache/kpm/sources" \
    "${ROOT_PREFIX}/var/cache/kpm/packages" \
    "${ROOT_PREFIX}/var/cache/kpm/work" \
    "${ROOT_PREFIX}${PORTS_DIR}"

if [[ ! -f "${ROOT_PREFIX}/var/lib/pkg/db" ]]; then
    : > "${ROOT_PREFIX}/var/lib/pkg/db"
    chmod 0444 "${ROOT_PREFIX}/var/lib/pkg/db"
fi

KPM_INI="${ROOT_PREFIX}/etc/kpm.ini"
cat > "$KPM_INI" <<EOF
# /etc/kpm.ini - KryX Linux package manager configuration (generated by setup-repo)

[paths]
root = /
ports_dir = ${PORTS_DIR}
collections = pkg-tools, kernel, core, opt, xorg, contrib
cache_dir = /var/cache/kpm
source_cache = /var/cache/kpm/sources
package_dir = /var/cache/kpm/packages
work_dir = /var/cache/kpm/work
pkgadd_conf = /etc/pkgadd.conf
keys_dir = /etc/kpm/keys.d
ports_conf_dir = /etc/ports
ports_drivers_dir = /etc/ports/drivers

[repo]
repository = ${REPO_SLUG}
tag = ${RELEASE_TAG}
arch = ${ARCH}
index_url = ${INDEX_URL}
verify_signature = ${VERIFY_SIG}
timeout_seconds = 120

[build]
jobs = $(nproc 2>/dev/null || echo 4)
cflags = -O2 -march=x86-64 -pipe
cxxflags = -O2 -march=x86-64 -pipe
ldflags =
compression = zst
download_sources = true
strip = true
compress_manpages = true
ignore_footprint = false
ignore_new = false
ignore_md5sum = false
ignore_signature = true
keep_work = false
download_prog = curl

[ui]
color = auto
EOF
chmod 0644 "$KPM_INI"

PORTS_LIST="${ROOT_PREFIX}/etc/ports/sources.list"
if [[ ! -f "$PORTS_LIST" ]]; then
    cat > "$PORTS_LIST" <<EOF
# /etc/ports/sources.list - KryX Linux ports collections (used by \`ports\` / \`kpm ports\`)
# Format: <protocol> <collection> <url> [destination]
# Place custom third-party overlays in /etc/ports/sources.list.d/*.list
git kryx    https://github.com/${REPO_SLUG}.git
git core    https://github.com/kryx-linux/core.git
git opt     https://github.com/kryx-linux/opt.git
git xorg    https://github.com/kryx-linux/xorg.git
git contrib https://github.com/kryx-linux/contrib.git
EOF
    chmod 0644 "$PORTS_LIST"
fi

if [[ ! -f "${ROOT_PREFIX}/etc/pkgadd.conf" ]]; then
    cat > "${ROOT_PREFIX}/etc/pkgadd.conf" <<'EOF'
# /etc/pkgadd.conf - CRUX/KryX package file preservation rules
UPGRADE		^etc/.*$		NO
UPGRADE		^var/log/.*$		NO
UPGRADE		^etc/kpm\.ini$		NO
UPGRADE		^etc/ports/sources\.list$	NO
EOF
    chmod 0644 "${ROOT_PREFIX}/etc/pkgadd.conf"
fi

# Create a host-side temporary config pointing cache_dir & keys_dir into TARGET_ROOT
# when bootstrapping an alternative root (so syncing writes into /mnt/var/cache/kpm).
HOST_KPM_INI="$KPM_INI"
TMP_INI=""
cleanup() {
    [[ -n "$TMP_INI" && -f "$TMP_INI" ]] && rm -f "$TMP_INI"
}
trap cleanup EXIT

if [[ "$TARGET_ROOT" != "/" ]]; then
    TMP_INI="$(mktemp "${TMPDIR:-/tmp}/setup-repo-kpm.XXXXXX.ini")"
    sed \
        -e "s|^root = .*|root = ${TARGET_ROOT}|" \
        -e "s|^ports_dir = .*|ports_dir = ${ROOT_PREFIX}${PORTS_DIR}|" \
        -e "s|^cache_dir = .*|cache_dir = ${ROOT_PREFIX}/var/cache/kpm|" \
        -e "s|^source_cache = .*|source_cache = ${ROOT_PREFIX}/var/cache/kpm/sources|" \
        -e "s|^package_dir = .*|package_dir = ${ROOT_PREFIX}/var/cache/kpm/packages|" \
        -e "s|^work_dir = .*|work_dir = ${ROOT_PREFIX}/var/cache/kpm/work|" \
        -e "s|^keys_dir = .*|keys_dir = ${ROOT_PREFIX}/etc/kpm/keys.d|" \
        "$KPM_INI" > "$TMP_INI"
    HOST_KPM_INI="$TMP_INI"
fi

if [[ -n "$KEY_SRC" ]]; then
    if [[ ! -x "$KPM_BIN" ]]; then
        echo "setup-repo: error: kpm binary not found at ${KPM_BIN} (needed for --key)" >&2
        exit 1
    fi
    "$KPM_BIN" --config "$HOST_KPM_INI" key trust "$KEY_SRC"
fi

if [[ "$DO_SYNC" -eq 1 ]]; then
    if [[ ! -x "$KPM_BIN" ]]; then
        echo "setup-repo: warning: kpm binary not found at ${KPM_BIN}; skipping index sync" >&2
    else
        echo "[setup-repo] Syncing binary index from ${INDEX_URL}..."
        "$KPM_BIN" --config "$HOST_KPM_INI" sync
    fi
fi

if [[ "$DO_SYNC_PORTS" -eq 1 ]]; then
    if [[ -x "$KPM_BIN" ]]; then
        echo "[setup-repo] Syncing local ports tree via kpm ports..."
        "$KPM_BIN" ports -c "$PORTS_LIST" -p "${ROOT_PREFIX}${PORTS_DIR}" -u
    elif command -v ports >/dev/null 2>&1; then
        echo "[setup-repo] Syncing local ports tree via ports..."
        ports -c "$PORTS_LIST" -p "${ROOT_PREFIX}${PORTS_DIR}" -u
    else
        echo "setup-repo: warning: kpm/ports not found in PATH; skipping ports sync" >&2
    fi
fi

echo "[setup-repo] Done. Config written to ${KPM_INI}."
